{
  "expo": {
    "name": "Elgemo",
    "slug": "elgemo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/elgemo-logo.png",
    "favicon": "./assets/favicon.ico",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elgemo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Elgemo needs camera access for video calls",
        "NSMicrophoneUsageDescription": "Elgemo needs microphone access for voice calls"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/elgemo-logo.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.elgemo.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "@config-plugins/react-native-webrtc"
    ]
  }
}
